<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_pink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_pink</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="LaunchTheme" parent="BaseLaunchTheme" />

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
